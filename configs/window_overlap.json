{
  "name": "partial_window_overlap",
  "seed": 11701,
  "model": {
    "vocab_size": 16,
    "d_model": 96,
    "n_heads": 4,
    "n_layers": 4,
    "mlp_ratio": 3,
    "dense_window": 1,
    "retrieval_budget": 4,
    "block_size": 4,
    "address_stride": 4,
    "dropout": 0.0,
    "attention_kind": "qkvs",
