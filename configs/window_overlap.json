    "steps": 1400,
    "eval_batches": 24,
    "learning_rate": 0.0006,
    "weight_decay": 0.01,
    "route_loss_weight": 0.2,
    "route_loss_space": "blocks",
    "teacher_floor": 1.0,
    "query_only_retrieval": true,
    "checkpoint_every": 100,
    "log_every": 100
  },
  "runs": [
    {"name": "span_block_aligned"},
    {
      "name": "span_partial_overlap",
      "model": {"address_stride": 1}
