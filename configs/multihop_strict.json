{
  "name": "strict_query_cascade",
  "seed": 4701,
  "model": {
    "vocab_size": 32,
    "d_model": 96,
    "n_heads": 4,
    "n_layers": 4,
    "mlp_ratio": 3,
    "dense_window": 1,
    "retrieval_budget": 1,
    "block_size": 1,
    "dropout": 0.0,
    "attention_kind": "qkvs",
    "router_mode": "learned"
  },
  "training": {
    "hops": 3,
    "train_seq_len": 64,
    "eval_seq_lens": [64, 128, 256],
    "batch_size": 64,
    "steps": 1600,
    "eval_batches": 16,
    "learning_rate": 0.0006,
    "weight_decay": 0.01,
    "route_loss_weight": 10.0,
    "teacher_decay_fraction": 0.9,
    "teacher_floor": 0.0,
    "query_only_retrieval": true,
    "log_every": 100
  },
  "runs": [
    {
      "name": "three_hop_strict_curriculum",
      "hops": 3,
      "training": {"hop_curriculum": [1, 2, 3]}
    },
    {
      "name": "three_hop_strict_teacher",
      "hops": 3,
      "training": {"teacher_floor": 1.0}
    },
    {
      "name": "four_hop_strict_curriculum",
      "hops": 4,
      "training": {"hop_curriculum": [1, 2, 3, 4]}
    }
  ]
}
