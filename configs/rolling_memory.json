{
  "name": "rolling_memory_sink",
  "seed": 12701,
  "model": {
    "vocab_size": 32,
    "d_model": 96,
    "n_heads": 4,
    "n_layers": 4,
    "mlp_ratio": 3,
    "dense_window": 8,
    "retrieval_budget": 1,
    "block_size": 1,
    "dropout": 0.0,
    "attention_kind": "qkvs",
    "router_mode": "learned",
    "n_token_types": 4,
    "pointer_encoding": "fourier"
  },
  "training": {
    "task": "memory_anchor",
    "hops": 1,
    "memory_source_window": 8,
    "train_seq_len": 64,
    "eval_seq_lens": [64, 128, 256],
    "batch_size": 32,
    "eval_batch_size": 8,
    "steps": 1600,
    "eval_batches": 24,
    "learning_rate": 0.0006,
    "weight_decay": 0.01,
    "route_loss_weight": 0.2,
    "route_loss_space": "blocks",
    "teacher_floor": 1.0,
    "query_only_retrieval": true,
    "checkpoint_every": 100,
    "log_every": 100
  },
  "runs": [
    {"name": "memory_sink_rolling"},
    {
      "name": "memory_sink_no_rolling",
      "model": {"dense_window": 1}
    }
  ]
}
