{
  "name": "scaled_competing_memory",
  "seed": 13701,
  "model": {
    "vocab_size": 16,
    "d_model": 128,
    "n_heads": 4,
    "n_layers": 4,
    "mlp_ratio": 2,
    "dense_window": 128,
    "retrieval_budget": 128,
    "block_size": 16,
    "address_stride": 4,
    "dropout": 0.0,
    "attention_kind": "qkvs",
    "router_mode": "learned",
    "n_token_types": 4,
    "semantic_vocab_size": 4,
    "pointer_encoding": "fourier",
    "sparse_backend": "streaming",
    "query_chunk_size": 128,
    "candidate_tile_size": 64,
    "checkpoint_sparse": true
  },
  "training": {
    "task": "memory_bank",
    "hops": 1,
    "answer_vocab_size": 16,
    "memory_bank_keys": 4,
    "memory_bank_distractors": 3,
    "memory_bank_source_offset": 32,
    "memory_loss_weight": 1.0,
    "train_seq_len": 1024,
    "train_seq_lengths": [1024, 1536, 2048],
    "eval_seq_lens": [1024, 2048, 4096, 8192],
    "batch_size": 2,
    "eval_batch_size": 1,
    "steps": 600,
    "eval_batches": 16,
    "learning_rate": 0.0006,
    "weight_decay": 0.01,
    "route_loss_weight": 0.02,
    "route_loss_space": "blocks",
    "teacher_decay_fraction": 0.7,
    "teacher_floor": 0.5,
    "query_only_retrieval": true,
    "checkpoint_every": 25,
    "log_every": 25
  },
  "runs": [
    {"name": "scaled_memory_streaming"},
    {
      "name": "scaled_memory_no_rolling",
      "model": {"dense_window": 1}
    }
  ]
}
