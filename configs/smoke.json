{
  "name": "smoke",
  "seed": 101,
  "model": {
    "vocab_size": 16,
    "d_model": 48,
    "n_heads": 4,
    "n_layers": 3,
    "mlp_ratio": 2,
    "dense_window": 8,
    "retrieval_budget": 4,
    "block_size": 1,
    "dropout": 0.0,
    "attention_kind": "qkvs",
    "router_mode": "learned"
  },
  "training": {
    "train_seq_len": 32,
    "eval_seq_lens": [32, 64],
    "batch_size": 8,
    "steps": 4,
    "eval_batches": 2,
    "learning_rate": 0.001,
    "weight_decay": 0.0,
    "route_loss_weight": 4.0,
    "teacher_decay_fraction": 0.75,
    "log_every": 1
  },
  "runs": [
    {"name": "smoke_two_hop", "hops": 2}
  ]
}
